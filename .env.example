# ============================================================================
# structur-md — Environment Setup (placeholder)
#
# Copy file ini ke `.env.local` lalu isi valuenya dari Supabase Dashboard.
#   cp .env.example .env.local
#
# Cara dapat value (Supabase Dashboard -> Project Settings):
#   1. SUPABASE_URL      -> API  -> Project URL       (https://xxxx.supabase.co)
#   2. SUPABASE_ANON_KEY -> API  -> anon/public key
#   3. SUPABASE_SERVICE_ROLE_KEY -> API -> service_role key (RAHASIA, server-only)
#   4. SUPABASE_BUCKET   -> kamu buat bucket dulu, atau biarkan default
#      `markdown-results` lalu jalankan sql/schema.sql (bikin otomatis).
#
# Catatan keamanan:
#   - jangan pernah commit `.env.local` (sudah ada di .gitignore)
#   - SERVICE_ROLE hanya dipakai di sisi server (api/*), jangan pernah
#     dipakai/expose di client.
# ============================================================================

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=markdown-results

# --- Scraper (opsional, default sudah aman) ---
# Maks waktu tunggu fetch halaman (ms). Default 15000. Untuk target statis,
# biasanya selesai < 2-3 detik dan aman untuk Vercel Free (limit 4.5s).
SCRAPE_TIMEOUT_MS=15000
# Ukuran output markdown maksimal (bytes). Default 1_500_000.
SCRAPE_MAX_BYTES=1500000